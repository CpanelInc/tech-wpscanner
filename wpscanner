# NOTE: the exact field names for the new "epss" and "kev" blocks were
# reconstructed from WPVulnerability's announcement email and public docs;
# the vendor's own field-mapping page could not be fully verified against a
# live JSON sample at the time this was written. extract_epss()/extract_kev()
# below check a few plausible key spellings defensively. If your real API
# responses use different key names, adjust those two subs only - everything
# else is independent of this.

my $SCRIPT_VERSION = "2.0";

my $coreEP   = "https://www.wpvulnerability.net/core";
my $pluginEP = "https://www.wpvulnerability.net/plugin";
my $themeEP  = "https://www.wpvulnerability.net/theme";

my $opt_plugin     = undef;
my $opt_version    = undef;
my $opt_theme      = undef;
my $opt_help       = undef;
my $opt_core       = undef;
my $opt_details    = 0;
my $opt_quick      = undef;
my $opt_epss       = 0;
my $opt_kev        = 0;
my $opt_cvss_pref  = 'auto';   # auto|4|3|2|legacy
my $opt_prioritize = 0;
my $opt_exit_code  = 0;        # when set, exit non-zero if unpatched/KEV vulns found

GetOptions(
    'core'        => \$opt_core,
    'plugin'      => \$opt_plugin,
    'version=s'   => \$opt_version,
    'theme'       => \$opt_theme,
    'details'     => \$opt_details,
    'quick'       => \$opt_quick,
    'epss'        => \$opt_epss,
    'kev'         => \$opt_kev,
    'cvss=s'      => \$opt_cvss_pref,
    'prioritize'  => \$opt_prioritize,
    'exit-code'   => \$opt_exit_code,
    'help'        => \$opt_help,
) or get_help();

get_help() if $opt_help;
get_help() unless ( $opt_plugin || $opt_core || $opt_theme );

my $found_unpatched = 0;

if ($opt_core) {
    my $core_ver = shift @ARGV;
    unless ( defined $core_ver && length $core_ver ) {
        print RED "ERROR - --core requires a WordPress core version, e.g. --core 7.0.4\n";
        exit 1;
    }
    get_wpcore_vuln($core_ver);
}

if ($opt_plugin) {
    my $plugin_slug = shift @ARGV;
    unless ( defined $plugin_slug && length $plugin_slug ) {
        print RED "ERROR - --plugin requires a plugin slug, e.g. --plugin wordfence\n";
        exit 1;
    }
    get_plugin_vuln($plugin_slug);
}

if ($opt_theme) {
    my $theme_slug = shift @ARGV;
    unless ( defined $theme_slug && length $theme_slug ) {
        print RED "ERROR - --theme requires a theme slug, e.g. --theme astra\n";
        exit 1;
    }
    get_theme_vuln($theme_slug);
}

exit( $opt_exit_code && $found_unpatched ? 1 : 0 );

# ---------------------------------------------------------------------------

sub get_wpcore_vuln {
    my $tcCoreVer = shift;
    my $coreJSON  = fetch_json("$coreEP/" . uri_escape($tcCoreVer));
    my $json_output = get_json_href($coreJSON);

    if ( !defined $coreJSON || $coreJSON eq '' ) {
        print RED "ERROR - Unable to reach the vulnerability database (network error or timeout).\n";
        exit 1;
    }
    if ( $json_output->{error} ) {
        print RED "ERROR - Querying the vulnerability database!\n";
        print expand( RED "\t\\_ " . ( $json_output->{message} // 'Unknown error' ) . "\n") if ( $opt_details );
        exit 1;
    }

    my $core_version = $json_output->{data}->{core};
    print CYAN "WordPress Core Version: $core_version\n" if ( $opt_details );

    my $results = get_data( $json_output->{data}->{vulnerability}, $tcCoreVer );
    my $cnt = $results->{count} || 0;
    $found_unpatched ||= $results->{unpatched_count};

    print "There are " . ( $cnt || "no" ) . " known vulnerabilities for the $core_version version of WordPress core" .
        ( $opt_details ? ".\n" : " [ pass --details for more details ].\n" );
}

sub get_plugin_vuln {
    my $tcPlugin_Slug = shift;
    my $tcVer = $opt_version;
    my $pluginJSON = fetch_json("$pluginEP/" . uri_escape($tcPlugin_Slug));

    if ( !defined $pluginJSON || $pluginJSON eq '' ) {
        print RED "ERROR - Unable to reach the vulnerability database (network error or timeout).\n";
        exit 1;
    }
    my $json_output = get_json_href($pluginJSON);
    if ( $json_output->{error} ) {
        print RED "ERROR - Querying the vulnerability database!\n";
        exit 1;
    }

    my $plugin_link = $json_output->{data}->{link};
    my $plugin_name = $json_output->{data}->{name};
    unless ($plugin_name) {
        print "Plugin $tcPlugin_Slug doesn't seem to exist!\n";
        return;
    }
    print CYAN "Plugin: $plugin_name - $plugin_link\n" if ( $opt_details );

    my $results = get_data( $json_output->{data}->{vulnerability}, $tcVer );
    my $cnt           = $results->{count} || 0;
    my $cnt_patched   = $results->{patched_count} || 0;
    my $cnt_unpatched = $results->{unpatched_count} || 0;
    $found_unpatched ||= $cnt_unpatched;

    if ($opt_quick) {
        print CYAN $tcPlugin_Slug, WHITE " has ", MAGENTA $cnt_unpatched, WHITE " out of ", BOLD, BLUE $cnt, WHITE " open vulnerabilities";
        print WHITE ", ", RED "IN CISA KEV" if $results->{any_kev};
        print "\n";
        return;
    }

    print "There are " . ( $cnt || "no" ) . " known vulnerabilities for the $tcPlugin_Slug WordPress Plugin" .
        ( $opt_details ? ".\n" : " [ pass --details for more details ].\n" );

    if ( $cnt_patched || $cnt_unpatched ) {
        my $is_are_patched   = ( $cnt_patched == 1 )   ? "is"  : "are";
        my $is_are_unpatched = ( $cnt_unpatched == 1 ) ? "is"  : "are";
        print "\t\\_ Of which $cnt_patched $is_are_patched patched and $cnt_unpatched $is_are_unpatched not patched.\n" if ( $opt_details );
    }
}

