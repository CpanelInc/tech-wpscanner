sub get_help {
    print "WPScanner - CLI program to check for WordPress Vulnerabilities in WP Core as well as Plugins and Themes. Version $SCRIPT_VERSION\n";
    print expand("\t--core <version> - checks the Core version of WordPress vulnerabilities.\n");
    print expand("\t--plugin <plugin_name> - checks the Plugin for any/all vulnerabilities.\n");
    print expand("\t\t\\_ --version <plugin_version> - pass this to compare version number against vulnerability database.\n");
    print expand("\t\t\\_ --quick - pass this to get a quick output of Plugin vulns patched and unpatched (single line).\n");
    print expand("\t--theme <theme_name> - checks the Theme for any/all vulnerabilities.\n");
    print expand("\t--details - use with any of the above 3 options to get more details.\n");
    print expand("\t--epss - include EPSS (Exploit Prediction Scoring System) probability in the details output.\n");
    print expand("\t--kev - include CISA Known Exploited Vulnerabilities (KEV) status in the details output.\n");
    print expand("\t--cvss <auto|4|3|2|legacy> - which CVSS block to prefer when printing severity (default: auto = newest available).\n");
    print expand("\t--prioritize - sort vulnerabilities by risk: KEV first, then EPSS, then CVSS score.\n");
    print expand("\t--exit-code - exit non-zero if any unpatched vulnerability was found (useful for monitoring/cron).\n");
    print expand("\t--help - You're looking at it.\n");
    exit 0;
}

# Wrapper around curl so network failures are distinguishable from "no data".
sub fetch_json {
    my $url = shift;
    my $out = Cpanel::SafeRun::Timed::timedsaferun( 15, 'curl', '-s', '-f', $url );
    return $out;
}

sub get_json_href {
    my ( $raw, $fail_warning ) = @_;
    return {} unless defined $raw && length $raw;
    my $json = load_module_with_fallbacks(
        'needed_subs'  => [qw{new utf8 decode}],
        'modules'      => [qw{Cpanel::JSON::XS JSON::XS JSON::PP}],
        'fail_warning' => $fail_warning,
    );
    return {} unless $json;
    my $href;
    local $@;
    eval { $href = $json->new->utf8->decode($raw); };    # All or nothing, just be quiet.
    return {} if !$href;
    return $href;
}

sub load_module_with_fallbacks {
    my %opts = @_;
    my $namespace_loaded;
    foreach my $module2try ( @{ $opts{'modules'} } ) {
        if ( !$INC{ join( "/", split( "::", $module2try ) ) . ".pm" } ) {
            local $@;
            next if !eval "require $module2try; 1";    ## no critic (StringyEval)
        }
        next if ( scalar( grep { $module2try->can($_) } @{ $opts{'needed_subs'} } ) != scalar( @{ $opts{'needed_subs'} } ) );
        $namespace_loaded = $module2try;
        last;
    }

    if ( !$namespace_loaded ) {
        if ( !$opts{'fallback'} || ref $opts{'fallback'} ne 'CODE' ) {
            print RED( 'Missing Perl Module(s): ' . join( ', ', @{ $opts{'modules'} } ) . ' -- ' . ( $opts{'fail_warning'} // '' ) . " -- Try using /usr/local/cpanel/3rdparty/bin/perl?\n" ) if $opts{'fail_warning'};
            die "Stopping here." if $opts{'fail_fatal'};
        }
        else {
            $opts{'fallback'}->();
            $namespace_loaded = 'main';
        }
    }
    return $namespace_loaded;
}

# Picks the most useful CVSS block available for a vulnerability's impact
# data, honoring $opt_cvss_pref, and returns a normalized hashref:
# { block => 'cvss4'|'cvss3'|'cvss2'|'cvss', version, score, severity, vector }
# or undef if nothing usable is present.
sub pick_cvss {
    my $impact = shift;
    return undef unless ref $impact eq 'HASH';

    my @order = $opt_cvss_pref eq 'auto'    ? ( 'cvss4', 'cvss3', 'cvss2', 'cvss' )
              : $opt_cvss_pref eq '4'       ? ( 'cvss4', 'cvss3', 'cvss2', 'cvss' )
              : $opt_cvss_pref eq '3'       ? ( 'cvss3', 'cvss4', 'cvss2', 'cvss' )
              : $opt_cvss_pref eq '2'       ? ( 'cvss2', 'cvss3', 'cvss4', 'cvss' )
              : $opt_cvss_pref eq 'legacy'  ? ( 'cvss', 'cvss3', 'cvss4', 'cvss2' )
              :                               ( 'cvss4', 'cvss3', 'cvss2', 'cvss' );

    for my $block (@order) {
        my $data = $impact->{$block};
        next unless ref $data eq 'HASH';
        next unless defined $data->{score};
        return {
            block    => $block,
            version  => $data->{version},
            score    => $data->{score},
            severity => $data->{severity},
            vector   => $data->{vector},
            raw      => $data,
        };
    }
    return undef;
}

# Best-effort EPSS extraction - see NOTE at top of file about key names.
sub extract_epss {
    my $impact = shift;
    return undef unless ref $impact eq 'HASH';
    my $epss = $impact->{epss};
    return undef unless defined $epss;
    if ( ref $epss eq 'HASH' ) {
        return $epss->{score} // $epss->{epss} // $epss->{probability};
    }
    return $epss;    # plain scalar 0.0-1.0
}

# Best-effort KEV extraction - see NOTE at top of file about key names.
sub extract_kev {
    my $impact = shift;
    return undef unless ref $impact eq 'HASH';
    my $kev = $impact->{kev};
    return undef unless ref $kev eq 'HASH';
    return {
        date_added => $kev->{date_added}    // $kev->{dateAdded}   // $kev->{added},
        due_date   => $kev->{due_date}      // $kev->{dueDate}     // $kev->{deadline} // $kev->{remediation_due},
        ransomware => $kev->{ransomware}    // $kev->{knownRansomwareCampaignUse} // $kev->{known_ransomware_campaign_use} // 0,
    };
}

sub get_data {
    my ( $yy, $tcVer2 ) = @_;

    my $cnt           = 0;
    my $cnt_patched   = 0;
    my $cnt_unpatched = 0;
    my $any_kev       = 0;
    my @rows;

    for my $vuln ( @{ $yy // [] } ) {
        my $cveid = $vuln->{source}->[0]->{name};
        next unless $cveid && substr( $cveid, 0, 3 ) eq 'CVE';

        my $link = $vuln->{source}->[0]->{link};
        my $desc = $vuln->{source}->[0]->{description};
        my $maxver      = $vuln->{operator}->{max_version};
        my $maxoperator = $vuln->{operator}->{max_operator};

        my %op_map = ( lt => '<', le => '<=', gt => '>', ge => '>=', eq => '=', ne => '!=' );
        my $op = $op_map{ $maxoperator // '' };

        my $patched;
        if ( defined $tcVer2 && defined $op && defined $maxver ) {
            if ( Cpanel::Version::Compare::compare( $maxver, $op, $tcVer2 ) ) {
                $patched = 1;
                $cnt_patched++;
            }
            else {
                $patched = 0;
                $cnt_unpatched++;
            }
        }
        $cnt++;

        my $cvss  = pick_cvss( $vuln->{impact} );
        my $epss  = extract_epss( $vuln->{impact} );
        my $kev   = extract_kev( $vuln->{impact} );
        $any_kev++ if $kev;

        push @rows, {
            cveid => $cveid, link => $link, desc => $desc,
            patched => $patched, cvss => $cvss, epss => $epss, kev => $kev,
            impact => $vuln->{impact},
        };
    }

    if ($opt_prioritize) {
        @rows = sort {
            ( $b->{kev} ? 1 : 0 ) <=> ( $a->{kev} ? 1 : 0 )
                || ( $b->{epss} // 0 ) <=> ( $a->{epss} // 0 )
                || ( $b->{cvss} ? $b->{cvss}->{score} : 0 ) <=> ( $a->{cvss} ? $a->{cvss}->{score} : 0 )
        } @rows;
    }

    if ( $opt_details && !$opt_quick ) {
        my $i = 0;
        for my $row (@rows) {
            $i++;
            print expand( WHITE "[$i]\t----------\n" );

            my $patched_str = '';
            if ( defined $row->{patched} ) {
                $patched_str = $row->{patched} ? ( "\tPatched: " . GREEN "Yes" ) : ( "\tPatched: " . RED "No" );
            }
            print expand( YELLOW "\t\\_ CVE: " . WHITE $row->{cveid} . " " . GREEN( $row->{link} // '' ) . YELLOW "$patched_str\n" );
            print expand( YELLOW "\t\t\\_ " . BRIGHT_BLUE( $row->{desc} // '' ) . "\n" ) if $row->{desc};

            my $cweid    = eval { $row->{impact}->{cwe}->[0]->{cwe} } // q{};
            my $cwename  = eval { $row->{impact}->{cwe}->[0]->{name} } // q{};
            my $cwedesc  = eval { $row->{impact}->{cwe}->[0]->{description} } // q{};
            print expand( YELLOW "\t\t\\_ CWE: " . WHITE $cweid . " " . GREEN $cwename . "\n" ) if ($cweid);
            print expand( YELLOW "\t\t\\_ " . BRIGHT_BLUE $cwedesc . "\n" ) if ($cwedesc);

            if ( $row->{cvss} ) {
                my $c = $row->{cvss};
                print expand( MAGENTA "\t\t\\_ CVSS (" . $c->{block} . ( $c->{version} ? " v$c->{version}" : '' ) . "): "
                    . YELLOW( $c->{score} // '?' ) . MAGENTA( $c->{severity} ? " ($c->{severity})" : '' )
                    . CYAN( $c->{vector} ? "  $c->{vector}" : '' ) . "\n" );
                if ( $c->{block} eq 'cvss4' ) {
                    my $r = $c->{raw};
                    my @extra;
                    for my $k (qw(at vc vi va sc si sa)) {
                        push @extra, "$k=$r->{$k}" if defined $r->{$k};
                    }
                    print expand( MAGENTA "\t\t\t\\_ " . join( "  ", @extra ) . "\n" ) if @extra;
                }
            }

            if ( ( $opt_epss || $opt_details ) && defined $row->{epss} ) {
                my $label = $row->{epss} >= 0.5 ? RED "high" : $row->{epss} >= 0.1 ? YELLOW "moderate" : GREEN "low";
                print expand( MAGENTA "\t\t\\_ EPSS: " . WHITE $row->{epss} . " (" . $label . MAGENTA ")\n" );
            }

            if ( ( $opt_kev || $opt_details ) && $row->{kev} ) {
                print expand( RED BOLD "\t\t\\_ \x{26A0} IN CISA KEV CATALOG - confirmed exploited in the wild\n" );
                print expand( RED "\t\t\t\\_ Added: " . ( $row->{kev}->{date_added} // '?' )
                    . "  Remediation due: " . ( $row->{kev}->{due_date} // '?' )
                    . ( $row->{kev}->{ransomware} ? "  [known ransomware use]" : '' ) . "\n" );
            }

            my $cvss_vector = eval { $row->{impact}->{cvss}->{vector} } // q{};
            my $cvss_score  = eval { $row->{impact}->{cvss}->{score} } // q{};
            if ( !$row->{cvss} && $cvss_score ) {
                print expand( MAGENTA "\t\t\\_ Score: " . YELLOW $cvss_score . MAGENTA " Vector: " . CYAN $cvss_vector . "\n" );
            }
            print "\n";
        }
    }

    return {
        count           => $cnt,
        patched_count   => $cnt_patched,
        unpatched_count => $cnt_unpatched,
        any_kev         => $any_kev,
        rows            => \@rows,
    };
}

